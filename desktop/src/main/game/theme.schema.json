{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Coco runner theme",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "scoreLabel",
    "timeOfDay",
    "detail",
    "background",
    "textColor",
    "spritePalette",
    "player",
    "obstacles",
    "decorations",
    "ground",
    "weather",
    "physics",
    "sounds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 28
    },
    "scoreLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "timeOfDay": {
      "enum": [
        "morning",
        "day",
        "sunset",
        "night"
      ]
    },
    "detail": {
      "enum": [
        "simple",
        "detailed"
      ]
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "colors"
      ],
      "properties": {
        "type": {
          "enum": [
            "solid",
            "gradient"
          ]
        },
        "colors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      }
    },
    "textColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "spritePalette": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9]$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scale",
        "frames",
        "duck"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 4
        },
        "frames": {
          "$ref": "#/definitions/frames"
        },
        "duck": {
          "$ref": "#/definitions/grid"
        }
      }
    },
    "obstacles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "frames",
          "scale",
          "flying"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,30}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "frames": {
            "$ref": "#/definitions/frames"
          },
          "scale": {
            "type": "number",
            "minimum": 1,
            "maximum": 4
          },
          "flying": {
            "type": "boolean"
          }
        }
      }
    },
    "decorations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "color",
          "accent",
          "x",
          "y",
          "size",
          "count",
          "speed"
        ],
        "properties": {
          "kind": {
            "enum": [
              "sun",
              "moon",
              "stars",
              "clouds",
              "mountains",
              "trees"
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "accent": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "size": {
            "type": "number",
            "minimum": 2,
            "maximum": 100
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "speed": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "ground": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "height",
        "top",
        "soil",
        "speckle",
        "grass"
      ],
      "properties": {
        "height": {
          "type": "number",
          "minimum": 35,
          "maximum": 120
        },
        "top": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "soil": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "speckle": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "grass": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "color",
        "intensity",
        "speed"
      ],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "rain",
            "snow",
            "stars"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "intensity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "speed": {
          "type": "number",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speed",
        "maxSpeed",
        "acceleration",
        "gravity",
        "jumpVelocity",
        "spawnSeconds"
      ],
      "properties": {
        "speed": {
          "type": "number",
          "minimum": 100,
          "maximum": 600
        },
        "maxSpeed": {
          "type": "number",
          "minimum": 100,
          "maximum": 900
        },
        "acceleration": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "gravity": {
          "type": "number",
          "minimum": 600,
          "maximum": 3000
        },
        "jumpVelocity": {
          "type": "number",
          "minimum": 350,
          "maximum": 1100
        },
        "spawnSeconds": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 4
        }
      }
    },
    "sounds": {
      "type": "boolean"
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sky",
        "celestial",
        "clouds",
        "stars",
        "birds",
        "layers",
        "ground",
        "ambience",
        "effects",
        "hud"
      ],
      "properties": {
        "sky": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "celestial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "color",
            "x",
            "y",
            "radius",
            "rays"
          ],
          "properties": {
            "kind": {
              "enum": [
                "sun",
                "moon"
              ]
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "radius": {
              "type": "number",
              "minimum": 0,
              "maximum": 60
            },
            "rays": {
              "type": "boolean"
            }
          }
        },
        "clouds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "shade",
            "speed",
            "count"
          ],
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "shade": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "speed": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            }
          }
        },
        "stars": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "count"
          ],
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 120
            }
          }
        },
        "birds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "count"
          ],
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            }
          }
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "speed",
              "height",
              "colors",
              "seed"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "mountains",
                  "hills",
                  "forest",
                  "meadow"
                ]
              },
              "speed": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "height": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "colors": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "seed": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000
              },
              "trunk": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "capColor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "capDepth": {
                "type": "number",
                "minimum": 0,
                "maximum": 20
              },
              "scale": {
                "type": "number",
                "minimum": 0.2,
                "maximum": 2
              },
              "density": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32
              }
            }
          }
        },
        "ground": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grass",
            "soil",
            "flowers",
            "rock"
          ],
          "properties": {
            "grass": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "soil": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "flowers": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "rock": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        },
        "ambience": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "color",
            "count"
          ],
          "properties": {
            "kind": {
              "enum": [
                "fireflies",
                "leaves"
              ]
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 80
            }
          }
        },
        "effects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dust",
            "flash"
          ],
          "properties": {
            "dust": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "flash": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        },
        "hud": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "surface",
            "text",
            "muted",
            "accent",
            "overTitle",
            "overLabel",
            "readyTitle",
            "restartLabel"
          ],
          "properties": {
            "surface": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "text": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "muted": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "overTitle": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            "overLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            "readyTitle": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            "restartLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            "startLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "lift",
        "riseSpeed"
      ],
      "properties": {
        "mode": {
          "enum": [
            "run",
            "fly"
          ]
        },
        "lift": {
          "type": "number",
          "minimum": 1800,
          "maximum": 5000
        },
        "riseSpeed": {
          "type": "number",
          "minimum": 100,
          "maximum": 600
        }
      }
    }
  },
  "definitions": {
    "grid": {
      "type": "array",
      "minItems": 4,
      "maxItems": 48,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 48
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/definitions/grid"
      }
    }
  }
}
