":root {\n  /* Shared desktop design tokens. Keep page styles semantic, not pixel-specific. */\n  --coco-font-family:\n    'Noto Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n\n  --coco-font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  --coco-text-caption: 12px;\n  --coco-text-secondary: 13px;\n  --coco-text-control: 14px;\n  --coco-text-body: 16px;\n  --coco-text-lead: 18px;\n  --coco-text-section: 20px;\n  --coco-text-title: 28px;\n  --coco-text-display: 36px;\n  --coco-leading-body: 1.5;\n  --coco-leading-control: 1.4;\n  --coco-leading-heading: 1.25;\n  --coco-space-1: 4px;\n  --coco-space-2: 8px;\n  --coco-space-3: 12px;\n  --coco-space-4: 16px;\n  --coco-space-6: 24px;\n  --coco-space-8: 32px;\n  --coco-control-height: 36px;\n  --coco-radius-pill: 999px;\n\n  --coco-color-primary: #204a79;\n  --coco-color-primary-hover: #173d68;\n  --coco-color-primary-rgb: 32, 74, 121;\n  --coco-color-accent: #467bae;\n  --coco-color-accent-soft: #e9efff;\n  --coco-color-accent-border: #bcd0fc;\n\n  /* Coco avatar fur (assets/pet1.png), with companion UI shades. */\n  --coco-color-orange: #fc7632;\n  --coco-color-orange-soft: #fff1e9;\n  --coco-color-orange-text: #9a3e12;\n\n  --coco-color-surface: #ffffff;\n  --coco-color-surface-subtle: #f9fafb;\n  --coco-color-surface-muted: #f3f4f6;\n  --coco-color-text: #111827;\n  --coco-color-text-secondary: #374151;\n  --coco-color-text-muted: #6b7280;\n  --coco-color-text-subtle: #6b7280;\n  --coco-color-border: #e5e7eb;\n\n  --coco-color-success: #16a34a;\n  --coco-color-success-rgb: 22, 163, 74;\n  --coco-color-danger: #b91c1c;\n  --coco-color-danger-soft: #fef2f2;\n  --coco-color-danger-border: #fecaca;\n\n  --coco-radius-control: 10px;\n  --coco-radius-card: 16px;\n  --coco-shadow-panel: 0 6px 20px rgba(0, 0, 0, 0.18);\n  --coco-focus-ring: 0 0 0 3px rgba(var(--coco-color-primary-rgb), 0.16);\n}\n*{box-sizing:border-box}body{margin:0;background:var(--coco-color-surface);color:var(--coco-color-text-secondary);font:13px var(--coco-font-family)}canvas{display:block;width:100%;image-rendering:pixelated;outline-offset:-3px;outline:none}canvas:focus-visible{outline:2px solid var(--coco-color-accent-border)}nav{height:58px;display:flex;align-items:center;gap:8px;padding:10px 16px;background:var(--coco-color-surface);border-top:1px solid var(--coco-color-border)}button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:32px;font:600 11px var(--coco-font-family);color:var(--coco-color-text-secondary);border:1px solid var(--coco-color-border);border-radius:var(--coco-radius-pill);background:var(--coco-color-surface-subtle);padding:7px 12px;cursor:pointer;touch-action:none}button:hover{background:var(--coco-color-accent-soft)}button:focus-visible{outline:2px solid var(--coco-color-primary);outline-offset:2px}kbd{font:10px var(--coco-font-family);color:var(--coco-color-text-muted);border:1px solid var(--coco-color-border);border-bottom-width:2px;border-radius:4px;background:var(--coco-color-surface);padding:1px 4px}#pause{margin-left:auto;border-color:transparent;background:transparent}\n"
